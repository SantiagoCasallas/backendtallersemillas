# Copia este archivo a .env antes de ejecutar Docker Compose. No subas .env a Git.
DB_PASSWORD=reemplaza-con-una-clave-local-larga
DB_USER=postgres
# Solo para compose.supabase.yaml: usa la cadena JDBC de conexión directa de Supabase.
# Ejemplo: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_URL=
# Debe ser Base64 de exactamente 32 bytes. Ver README para generarla.
DATA_ENCRYPTION_KEY=reemplaza-con-la-clave-base64-de-32-bytes
FRONTEND_ORIGINS=http://localhost:5173
